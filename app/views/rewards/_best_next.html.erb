<%# locals: (holder:) %>
<% ranking = RewardCard::Ranking.new(holder.eligibility) %>
<% if ranking.any? %>
  <section class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
    <div>
      <h2 class="text-lg font-medium"><%= t("rewards.best_next.title") %></h2>
      <p class="text-xs text-secondary">
        <%= t("rewards.best_next.hint") %>
        <% if RewardCard::Bonuses.reviewed_on %>
          <%= t("rewards.best_next.reviewed", date: RewardCard::Bonuses.reviewed_on.strftime("%b %-d, %Y")) %>
        <% end %>
      </p>
    </div>

    <% ranking.groups.each do |group| %>
      <div>
        <h3 class="text-xs uppercase font-medium text-secondary"><%= group.program&.name || t("rewards.best_next.other") %></h3>
        <ul class="divide-y divide-subdued">
          <% group.entries.each do |entry| %>
            <% offer = entry.offer %>
            <li class="py-2">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="text-sm font-medium text-primary flex items-center gap-1.5 flex-wrap">
                    <%= entry.product.name %>
                    <% if entry.product.business %>
                      <span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-gray-500/10 text-secondary whitespace-nowrap"><%= t("rewards.index.business") %></span>
                    <% end %>
                  </p>
                  <p class="text-xs text-secondary">
                    <%= t("rewards.best_next.spend", amount: number_to_currency(offer.spend, precision: 0), months: offer.months) if offer.spend && offer.months %>
                    <%= t("rewards.best_next.spend_only", amount: number_to_currency(offer.spend, precision: 0)) if offer.spend && !offer.months %>
                    <%= "· #{t("rewards.best_next.fee", amount: number_to_currency(offer.fee, precision: 0))}" if offer.fee %>
                  </p>
                  <%# One line per date, cards listed (first three, then a count). %>
                  <% { before: entry.before, after: entry.after }.each do |kind, delays| %>
                    <% delays.group_by(&:until).sort.each do |date, group| %>
                      <% names = group.map { |delay| delay.product.name } %>
                      <% shown = names.first(3).to_sentence + (names.size > 3 ? " " + t("rewards.best_next.more", count: names.size - 3) : "") %>
                      <p class="text-xs text-orange-600"><%= t("rewards.best_next.#{kind}", cards: shown, date: (group.first.indefinite? ? t("rewards.best_next.indefinitely") : date.strftime("%b %-d, %Y"))) %></p>
                    <% end %>
                  <% end %>
                  <% if offer.note.present? %>
                    <p class="text-xs text-secondary"><%= offer.note %></p>
                  <% end %>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-sm font-medium text-primary">
                    <%= offer.cash? ? number_to_currency(offer.amount, precision: 0) : "#{number_with_delimiter(offer.amount)} #{offer.unit}" %>
                  </p>
                  <% offer.extras.each do |extra| %>
                    <p class="text-xs <%= extra.portal? ? "text-green-600" : "text-secondary" %>">
                      + <%= extra.cash? ? number_to_currency(extra.amount, precision: 0) : "#{number_with_delimiter(extra.amount)} #{extra.unit}" %> <%= extra.label %>
                    </p>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>
<% end %>
