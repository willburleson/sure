<%= content_for :page_title, t(".title") %>
<%= content_for :page_actions do %>
  <%= render DS::Link.new(text: t(".add_card"), variant: "primary", href: new_reward_card_path(holder: @holder_name), icon: "plus", frame: :modal) %>
<% end %>

<div class="space-y-4 pb-6 lg:pb-12">
  <% if @summary.any? %>
    <nav class="flex gap-1 bg-container-inset rounded-lg p-1 w-fit max-w-full overflow-x-auto" aria-label="<%= t(".holders") %>">
      <% tabs = @summary.holder_names.map { |name| [ name, name ] } %>
      <% tabs << [ t(".household"), RewardsController::HOUSEHOLD ] if @summary.holder_names.size > 1 %>
      <% tabs.each do |label, value| %>
        <% active = @household ? value == RewardsController::HOUSEHOLD : value == @holder_name %>
        <%= link_to label, rewards_path(holder: value),
              class: "px-3 py-1 rounded-md text-sm font-medium whitespace-nowrap #{active ? "bg-container shadow-border-xs text-primary" : "text-secondary hover:text-primary"}",
              aria: { current: (active ? "page" : nil) } %>
      <% end %>
    </nav>
  <% end %>

  <% if @household %>
    <%= render "rewards/household", summary: @summary %>
  <% elsif @holder %>
    <%= render "rewards/tiles", holder: @holder %>

    <% if @holder.needs_details.any? %>
      <%= render "rewards/needs_details", holder: @holder %>
    <% end %>

    <div class="grid grid-cols-1 2xl:grid-cols-2 gap-4 items-start">
      <section class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
        <h2 class="text-lg font-medium"><%= t(".points") %></h2>
        <p class="text-xs text-secondary"><%= t(".points_hint") %></p>
        <%= render "rewards/points", holder: @holder %>
      </section>

      <%= render "rewards/eligibility", holder: @holder %>
    </div>

    <%= render "rewards/card_history", holder: @holder, show_closed: @show_closed %>
  <% else %>
    <div class="bg-container rounded-xl shadow-border-xs flex justify-center items-center py-20">
      <div class="text-center flex flex-col items-center max-w-[320px] gap-2">
        <p class="text-primary font-medium text-sm"><%= t(".empty") %></p>
        <%= render DS::Link.new(text: t(".add_card"), icon: "plus", href: new_reward_card_path, frame: :modal) %>
      </div>
    </div>
  <% end %>
</div>
