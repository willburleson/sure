<%# locals: (holder:, compact: false) %>
<% if holder.estimates.any? %>
  <div class="bg-container-inset rounded-xl p-1">
    <ul class="rounded-lg shadow-border-xs bg-container overflow-hidden text-sm">
      <% holder.estimates.each_with_index do |estimate, idx| %>
        <% format = ->(value) { estimate.cash? ? number_to_currency(value) : number_with_delimiter(value.to_i) } %>
        <% stale = estimate.as_of && estimate.as_of < Date.current - PointBalance::STALE_AFTER %>
        <li class="px-3 py-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4 <%= "table-divider" if idx < holder.estimates.size - 1 %>">
          <div class="flex items-start justify-between gap-3 sm:flex-1 min-w-0">
            <div class="min-w-0">
              <p class="font-medium text-primary"><%= estimate.catalog_program&.name || estimate.program %></p>
              <p class="text-xs text-secondary">
                <% if estimate.as_of %>
                  <%= link_to point_balances_path(holder: estimate.holder, program: estimate.program), class: "hover:text-primary #{"text-warning" if stale}", title: (t("rewards.points.stale") if stale), data: { turbo_frame: :modal } do %><span class="privacy-sensitive"><%= format.(estimate.recorded) %></span> <%= t("rewards.points.as_of", date: estimate.as_of.strftime("%-m/%-d/%y")) %><%= t("rewards.points.stale_short") if stale %><% end %>
                <% else %>
                  <%= t("rewards.points.no_balance") %>
                <% end %>
                <% if estimate.earned.nonzero? %>
                  &middot; <span class="privacy-sensitive" title="<%= t("rewards.points.earned_title", count: estimate.transaction_count, cards: estimate.cards.map(&:display_name).to_sentence) %>"><%= t("rewards.points.earned_since", amount: format.(estimate.earned)) %></span>
                <% end %>
                <% if !compact && estimate.cards.any? %>
                  &middot; <%= t("rewards.points.via", cards: estimate.cards.map(&:display_name).to_sentence) %>
                <% end %>
              </p>
            </div>
            <p class="text-base font-medium text-primary privacy-sensitive whitespace-nowrap"><%= estimate.balance ? format.(estimate.total) : "–" %></p>
          </div>
          <%= form_with model: PointBalance.new, url: point_balances_path, data: { turbo_frame: "_top" }, class: "flex items-center gap-2 sm:w-auto" do |f| %>
            <%= f.hidden_field :holder, value: estimate.holder %>
            <%= f.hidden_field :program, value: estimate.program %>
            <%= f.text_field :balance, inputmode: "decimal", required: true, placeholder: t("rewards.points.new_balance_placeholder"),
                  aria: { label: t("rewards.points.new_balance", program: estimate.catalog_program&.name) },
                  class: "flex-1 min-w-0 sm:flex-none sm:w-32 text-right text-sm px-2 py-1.5 rounded-md border border-secondary bg-container text-primary" %>
            <%= f.button t("rewards.points.save"), class: "shrink-0 text-xs font-medium px-3 py-1.5 rounded-md bg-container-inset hover:bg-container-inset-hover text-primary" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<% unless compact %>
  <%= form_with model: PointBalance.new, url: point_balances_path, class: "flex flex-wrap items-end gap-2 mt-3" do |f| %>
    <%= f.hidden_field :holder, value: holder.name %>
    <%= f.select :program, RewardCard::Catalog.programs.values.map { |program| [ program.name, program.key ] }, {},
          class: "text-sm px-2 py-1.5 rounded-md border border-secondary bg-container text-primary", aria: { label: t("rewards.points.program") } %>
    <%= f.text_field :balance, inputmode: "decimal", required: true, placeholder: t("rewards.points.balance"),
          class: "w-32 text-sm px-2 py-1.5 rounded-md border border-secondary bg-container text-primary", aria: { label: t("rewards.points.balance") } %>
    <%= f.button t("rewards.points.add_program"), class: "text-sm font-medium px-3 py-1.5 rounded-md bg-container-inset hover:bg-container-inset-hover text-primary" %>
  <% end %>
<% end %>
